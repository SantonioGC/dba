	echo "IDLE='$($P 'SHOW idle_in_transaction_session_timeout')'"
	echo "LOGCONN='$($P 'SHOW log_connections')'"
	echo "SUPERS='$($P "SELECT string_agg(rolname, ', ') FROM pg_roles WHERE rolsuper")'"
	echo "LOGINS='$($P "SELECT string_agg(rolname, ', ') FROM pg_roles WHERE rolcanlogin AND rolname NOT LIKE 'pg\_%'")'"
	echo "EXTS='$($P "SELECT string_agg(extname, ', ') FROM pg_extension")'"
	echo "AUTHS='$($P "SELECT string_agg(DISTINCT auth_method, ', ') FROM pg_hba_file_rules")'"
	echo "HBA='$($P "SELECT string_agg(type||' '||array_to_string(database,',')||' '||array_to_string(user_name,',')||' '||coalesce(address,'local')||' '||auth_method, ' ; ') FROM pg_hba_file_rules")'"
	echo "PERM_DATA='$(sudo stat -c '%a %U:%G' $D)'"
	echo "PERM_CONF='$(sudo stat -c '%a %U:%G' $D/postgresql.conf)'"
	echo "PERM_HBA='$(sudo stat -c '%a %U:%G' $D/pg_hba.conf)'"
	echo "SS_LISTEN='$(ss -lnt | awk '/:5432 /{print $4}' | paste -sd ',')'"
	} > configuracion/valores-$1.env
	EOF
	bash configuracion/captura.sh antes
	sudo -u postgres psql < sql/01-inspeccion.sql | tee configuracion/antes-sql.txt
	sudo -u postgres psql -c "SELECT rolname, rolsuper, rolcreaterole, rolcreatedb, rolcanlogin FROM pg_roles WHERE rolname NOT LIKE 'pg\_%' ORDER BY rolname;" | tee configuracion/antes-roles.txt
	sudo -u postgres psql -c "SELECT extname, extversion FROM pg_extension ORDER BY extname;" | tee configuracion/antes-extensiones.txt
	sudo ls -l /var/lib/pgsql/data/postgresql.conf /var/lib/pgsql/data/pg_hba.conf /var/lib/pgsql/data/pg_ident.conf | tee configuracion/antes-permisos.txt
	sudo ls -ld /var/lib/pgsql/data | tee -a configuracion/antes-permisos.txt
	ss -lntp | tee configuracion/antes-red.txt | grep 5432
	sudo firewall-cmd --list-all | tee configuracion/antes-firewall.txt
	sudo grep -v '^#' /var/lib/pgsql/data/pg_hba.conf | grep -v '^$' | tee configuracion/antes-pg_hba.txt
	rpm -q postgresql-server | tee configuracion/version-paquete.txt
	sudo cp /var/lib/pgsql/data/pg_hba.conf /var/lib/pgsql/data/pg_hba.conf.bak
	
	sudo tee /var/lib/pgsql/data/pg_hba.conf > /dev/null <<'EOF'
	local   all   postgres                 peer
	local   all   all                      scram-sha-256
	host    all   all   127.0.0.1/32       scram-sha-256
	host    all   all   ::1/128            scram-sha-256
	EOF
	
	sudo -u postgres psql < sql/02-roles.sql
	sudo -u postgres psql < sql/03-configuracion.sql
	
	sudo openssl req -new -x509 -days 365 -nodes -text -out /var/lib/pgsql/data/server.crt -keyout /var/lib/pgsql/data/server.key -subj "/CN=localhost"
	sudo chown postgres:postgres /var/lib/pgsql/data/server.crt /var/lib/pgsql/data/server.key
	sudo chmod 600 /var/lib/pgsql/data/server.key
	sudo restorecon -v /var/lib/pgsql/data/server.crt /var/lib/pgsql/data/server.key
	sudo -u postgres psql -c "ALTER SYSTEM SET ssl = on" -c "ALTER SYSTEM SET ssl_min_protocol_version = 'TLSv1.2'"
	
	sudo systemctl restart postgresql
	sudo -u postgres psql -c "\password app_user"
	bash configuracion/captura.sh despues
	sudo -u postgres psql < sql/04-verificacion.sql | tee configuracion/despues-sql.txt
	psql "host=127.0.0.1 dbname=postgres user=app_user sslmode=require" -c "SELECT ssl, version, cipher FROM pg_stat_ssl WHERE pid = pg_backend_pid();" | tee configuracion/despues-tls.txt
	ss -lntp | tee configuracion/despues-red.txt | grep 5432
	sudo grep -v '^#' /var/lib/pgsql/data/pg_hba.conf | grep -v '^$' | tee configuracion/despues-pg_hba.txt
	sudo ls -l /var/lib/pgsql/data/postgresql.conf /var/lib/pgsql/data/pg_hba.conf | tee configuracion/despues-permisos.txt
	source <(sed 's/^/A_/' configuracion/valores-antes.env)
	source <(sed 's/^/D_/' configuracion/valores-despues.env)
	
	cat > configuracion/baseline.md <<EOF_BASELINE
	# Baseline de seguridad — PostgreSQL 16
	
	## Comparación antes y después
	
	| Control | Antes | Después | Justificación |
	|---|---|---|---|
	| listen_addresses | $A_LISTEN | $D_LISTEN | Escuchar solo en la interfaz local reduce la exposición de red |
	| pg_hba.conf | $A_HBA | $D_HBA | Reglas específicas por tipo, usuario y origen, sin rangos amplios |
	| Método de autenticación | $A_AUTHS (contraseñas: $A_PWENC) | $D_AUTHS (contraseñas: $D_PWENC) | scram-sha-256 es más seguro que md5, ident o trust |
	| Usuarios administrativos | $A_SUPERS | $D_SUPERS | Solo debe existir el superusuario necesario |
	| Cuentas de aplicación | Roles con login: $A_LOGINS | Roles con login: $D_LOGINS | Cuentas separadas y sin privilegios administrativos |
	| Puerto | $A_PUERTO (escucha en $A_SS_LISTEN) | $D_PUERTO (escucha en $D_SS_LISTEN) | Se documenta el 5432;
